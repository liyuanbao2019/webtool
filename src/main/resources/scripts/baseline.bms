%,#@,%%36a42c657e5b41d1be1b4ab0abb78659%
#20250518
chk_user_role() {
  local UP_GIDMIN=$(cat /etc/login.defs|awk '/^ *GID_MIN/{print $2}')
  local UP_GIDMAX=$(cat /etc/login.defs|awk '/^ *GID_MAX/{print $2}')

  cat /etc/shadow | awk -F: -v gidmin=$UP_GIDMIN -v gidmax=$UP_GIDMAX '
    BEGIN {
    num=0
    split("oracle sybase postgres test ceshi admin", tmp, " ")
    for(i in tmp){
      db_array[tmp[i]]=1
    }
    while ((getline line < "/etc/passwd") > 0) {
      split(line, passwd_fields, ":")
      user = passwd_fields[1]
      uid = passwd_fields[3]
      gid = passwd_fields[4]
      home = passwd_fields[6]
      shell = passwd_fields[7]
      if(shell ~/bin\/.*sh$/ && gid>=gidmin && gid<=gidmax && !(user in db_array)){
        passwd[user] = user ":" uid ":" gid ":" home ":" shell
      }
    }
    close("/etc/passwd")
    }{
      split($0, shadow_fields, ":")
      user = shadow_fields[1]
      is_locked= shadow_fields[2]
      if (is_locked!~/[!\*]+/ && user in passwd) {
        print passwd[user]
        num+=1
      }
    }END{
      print "The number of users that meet the requirements: result="num
  }'
}
chk_user_role;unset chk_user_role
%,#@,%%36a42c657e5b41d1be1b4ab0abb78659%
%,#@,%%1be17932845a45ca9b8def74c5544f7c%
#20260824
chk_ssh_max() {
  local sshd_pid sshd_bin
  sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [ ! -e "$sshd_bin" ] || [ ! -x "$sshd_bin" ]; then
    sshd_bin=$(which sshd)
  fi
  if ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) &>/dev/null; then
    echo "=====>check in sshd command"
    ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) 2>/dev/null | awk '/^[Mm]ax[Ss]tartups/{
      print $0, ($2 != "" ? "check result:true" : "check result:false")
    }'
  else
    echo "=====>check in sshd_config file"
    cat /etc/ssh/sshd_config | awk '
      BEGIN{num=0}
      /^[ \t]*[Mm]ax[Ss]tartups/{
        num+=1
        print $0, ($2 != "" ? "check result:true" : "check result:false")
      }END{
        if(NR==0){print "No permission or The /etc/ssh/sshd_config does not exist, check result:false"}
        else if(num==0){print "The MaxStartups is default(10:30:100), check result:true"}
    }'
  fi
}
chk_ssh_max; unset -f chk_ssh_max
%,#@,%%1be17932845a45ca9b8def74c5544f7c%
%,#@,%%4feedb2e05d0429caedb0b313c04a791%
#20251120
chk_sshd_cipher() {
  local sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  local sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [ ! -e "$sshd_bin" ] || [ ! -x "$sshd_bin" ]; then
      sshd_bin=$(which sshd)
  fi
  $sshd_bin -T -C user=john 2>/dev/null | grep -E -i '^[[:space:]]*(Ciphers|KexAlgorithms|MACs)'
  if [ $? -ne 0 ];then
    ssh -V
    $sshd_bin -T 2>/dev/null | grep -E -i '^[[:space:]]*(Ciphers|KexAlgorithms|MACs)'
    if [ $? -ne 0 ];then
      cat /etc/ssh/sshd_config| grep -Ev '^[[:space:]]*#|^$'|grep -E -i 'Ciphers|KexAlgorithms|MACs'
    fi
  fi
}
chk_sshd_cipher; unset chk_sshd_cipher
%,#@,%%4feedb2e05d0429caedb0b313c04a791%
%,#@,%%5df69ec292bd401f97b41480e8af1174%
#20251016
chk_timesync() {
  if command -v chronyc >/dev/null 2>&1; then
    chronyc tracking 2>/dev/null | awk '
    /Leap.*Normal/ {
      print $0, "\nchrony synchronization normal, check result=true" }'
  fi
  if command -v timedatectl >/dev/null 2>&1 && [ "$(ps -ef | grep timesyncd | grep -v grep | wc -l)" -ne 0 ]; then
    timedatectl timesync-status 2>/dev/null | awk '
    /Leap.*normal/ {
      print $0, "\ntimesyncd synchronization normal, check result=true" }'
  fi

  if command -v ntpq >/dev/null 2>&1; then
    ntpq -np 2>/dev/null | awk '{if($2!~/LOCL/ && $5~/[0-9]$/ && $5<$6){
      print $0,"\nntpdate using ntpd service, check result=true";exit}
    else if($2!~/LOCL/ && $5="-"){
      print $0,"\nntpdate using ntpd service, check result=true";exit}
    }'
  fi

  if command -v ntpdate >/dev/null 2>&1; then
    ntpdate $(crontab -l 2>/dev/null | grep -oP '(?:\d{1,3}\.){3}\d{1,3}|(?:[0-9A-Fa-f]{1,4}):+[\da-zA-Z\:]+') 2>/dev/null | awk '
    /(adjust|step) time server.*offset/ {
      print $0, "\nntpdate using cron job, check result=true" }'
  fi
}
chk_timesync;unset chk_timesync
%,#@,%%5df69ec292bd401f97b41480e8af1174%
%,#@,%%e21847bf6ab34e2682dcf53ce7dac11f%
#20260126
unused_users() {
  local unlock_users=$(cat /etc/shadow | awk -F: '
  BEGIN {
    while ((getline line < "/etc/passwd") > 0) {
        split(line, passwd_fields, ":")
        user = passwd_fields[1]
        shell = passwd_fields[7]
        if(shell ~/bin\/.*sh$/ && user !~/^( *root)$/){
          passwd[user] = user ":" shell
        }
    }
    close("/etc/passwd")
  }
  {
    split($0, shadow_fields, ":")
    user = shadow_fields[1]
    is_locked= shadow_fields[2]
    if (is_locked!~/[!\*]+/ && user in passwd) {
        print user
    }
  }')
  if [ -f /etc/login.defs ]; then
    local up_uidmin=$(cat /etc/login.defs |grep -Ev '^#|^$' |grep "^UID_MIN"|awk '($1=="UID_MIN"){print $2}')
  fi
  local init_num=0
  for uu in $unlock_users;do
    if [ "$(id -u "$uu")" -lt "${up_uidmin:=1000}" ] || [ "$(echo "$uu"|grep -Ec -e '^(test.*|ceshi.*|admin.*)' -e '^(adm|apache|at|avahi|bin|daemon|dbus)$' -e '^(distcache|ftp|games|gdm|gopher|haldaemon)$' -e '^(halt|irc|ldap|listen|lp|mail|mailnull|man)$' -e '^(mysql|named|news|nfsnobody|noaccess|nobody)$' -e '^(nobody4|nscd|ntp|operator|pcap|pop|postfix)$' -e '^(postgres|rpc|rpcuser|rpm|sabayon|shutdown)$' -e '^(smmsp|snort|squid|sync|uucp|vcsa)$' -e '^(webalizer|webservd|wwwrun|xfs)$')" -eq 1 ]; then
      ((init_num++));echo "Non-compliant users: $uu";id "$uu"
    fi
  done
  if [ "$(id -u)" -eq 0 ];then
    echo "The number of Non-compliant users, result="${init_num:=0}
  else
    echo "Insufficient permissions, check failed, result=10"
  fi
  echo "The UID_MIN in the login.defs file: $up_uidmin"
}
unused_users;unset unused_users
