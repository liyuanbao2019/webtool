%,#@,%%d13f366b2ef74d3389f0ae62f25eac47%
#20251017
check_autofs() {
  local autofs_status=0
  if command -v systemctl 2>/dev/null; then
    systemctl show "autofs.service" | grep -i unitfilestate
    autofs_status=`systemctl list-units |grep autofs |grep -i running | wc -l`
  fi
  if [ "$autofs_status" -eq 0 ] && command -v chkconfig 2>/dev/null; then
    chkconfig --list autofs 2>/dev/null
    autofs_status=`chkconfig --list autofs 2>/dev/null|grep -i on|wc -l`
  fi
  if [ "$autofs_status" != "0" ];then
    echo "The AutoFS is enable,check result=false";
  else 
    echo "The AutoFS is disabled,check result=true";
  fi
}
check_autofs;unset check_autofs
