#20251020
chk_pathevn() {
  if [ ! `echo $PATH |grep -E ':\.|\.:'` ];then
    echo "The PATH environment variable does not contains . or .., check result=true";
  else
    echo "The PATH environment variable contains . or .., check result=false";
  fi
  local dirs=$(echo $PATH|awk -F: '{for(i=1;i<=NF;i++)print $i}')
  stat -Lc "%N %a" $dirs 2>/dev/null|awk '$NF==777{print $0,"check result=false"}'
}
chk_pathevn;unset chk_pathevn
