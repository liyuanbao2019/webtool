%,#@,%%4c835be1728c4006bae4f7c0fb2c8157%
#20251024
chk_logfile() {
  local syslog_cfg="/etc/rsyslog.conf"
  local ng_cfg="/etc/syslog-ng/syslog-ng.conf"
  if [ ! -f "$syslog_cfg" ];then
    syslog_cfg="/etc/syslog.conf"
  fi
  if [ -f "$syslog_cfg" ];then
    local log_files=$(cat $syslog_cfg 2>/dev/null|grep -Eo '/var/log/[A-Za-z0-9\.\-\/]+'|sort |uniq)
  elif [ -f "$ng_cfg" ];then
    local log_files=$(cat $ng_cfg 2>/dev/null|grep -Eo '/var/log/[A-Za-z0-9\.\-\/]+'|sort |uniq) 
  fi
  if [ -n "$log_files" ];then
    echo "====>check log files from configuration file"
    find -L $log_files -maxdepth 1 -type f -name "*.log" -type f -perm /137 -ls 2>/dev/null
  else
    echo "====>check log files from /var/log"
    find -L /var/log -maxdepth 2 -type f -name "*.log" -type f -perm /137 -ls -quit 2>/dev/null
  fi|awk 'BEIGIN{file_num=0}{file_num+=1;print $0}END{
    if(file_num>1){print "The permissions of the log file are higher than 640. check_result=false"}
    else{print "check_result=true"}
  }'
}
chk_logfile;unset chk_logfile
%,#@,%%4c835be1728c4006bae4f7c0fb2c8157%
%,#@,%%bc5af5ed5e3f4dd5b8225b00cdb02a6b%
#20250704
chk_syslog() {
  local syslog_conf=/etc/rsyslog.conf;
  if [ ! -f  "$syslog_conf" ];then 
    syslog_conf=/etc/syslog.conf;
  fi
  if [ -f "$syslog_conf" ];then
    echo "===============>check $syslog_conf"
    local include_cfg=$(cat $syslog_conf|awk '/^\$IncludeConfig/{print $2}')
    local syslog_content=$(cat $syslog_conf $include_cfg 2>/dev/null|grep -Ev '^[[:space:]]*#|^$|@')
    echo "$syslog_content"
    echo "$syslog_content"|awk '{if($1 ~ "cron\\.\\*|\\*\\.\\*"){print $1", check_result=true"}}'
  fi
}

chk_syslog_ng() {
  local ng_cfg=/etc/syslog-ng/syslog-ng.conf 
  if [ -f "$ng_cfg" ];then
    echo "===============>check $ng_cfg"
    local include_cfg=$(cat $ng_cfg |awk '/^@include/{if($2!~/^\"\//){print "/etc/syslog-ng/"$2}else{print $2}}'|sed 's/"//g')
    local ng_content=$(cat $ng_cfg $include_cfg 2>/dev/null|grep -Ev '^[[:space:]]*#|^$')
    echo "$ng_content"
    echo "$ng_content"|awk '/^log.*filter\(f_cron/{print $0," check_result=true"}'
  fi
}
chk_main() {
  local is_actived=$(ps -ef |grep -E 'syslogd|syslog-ng'|grep -v grep|wc -l)
  if [ ${is_actived:=0} -ne 0 ]; then
    chk_syslog;chk_syslog_ng;unset chk_syslog chk_syslog_ng
  else
    echo "syslog service is not running, check_result=false"
  fi
}
chk_main;unset chk_main
%,#@,%%bc5af5ed5e3f4dd5b8225b00cdb02a6b%
%,#@,%%7cec392fc40a4157b5ce88a01bc26c70%
#20250814-lyl
chk_anolisgt(){
  [ "$LC_ALL" != "en_US.UTF-8" ] && export LC_ALL="en_US.UTF-8" 2>/dev/null
  local release_string=$(timeout 20 /bin/rpm -q anolis-release 2>/dev/null |grep -Ev 'not installed|未安装')
  local OS_TYPE=""
  local OS_VERSION=""
  if [ -n "$release_string" ];then
    echo "====>check anolis rpm package info"
    OS_TYPE=anolis
    OS_VERSION=$(echo "$release_string" |grep -Ev 'not installed|未安装'|sed 's/.*-\([0-9.]\+\-[0-9.]\+\)\.an.*/\1/')
  elif release_string=$(rpm -q bclinux-release 2>/dev/null|grep '\.el');then
    echo "====>check bclinux rpm package info"
    OS_TYPE=bclinux4anolis
    OS_VERSION=$(echo "$release_string" |grep -Ev 'not installed|未安装'|sed 's/.*-\([0-9.]\+\-[0-9.]\+\)\.el.*/\1/')
  else
    release_string=$(grep -i ^Anolis /etc/anolis-release 2>/dev/null)
    echo "====>check anolis-release file version info"
    [ -n "$release_string" ] && OS_TYPE="anolis"
    [ -n "$release_string" ] && OS_VERSION=$(cat /etc/anolis-release |sed 's/.* \([0-9.]\+\).*/\1/')
    release_string=$(grep -i '^BigCloud Enterprise Linux release' /etc/bclinux-release 2>/dev/null)
    echo "====>check bclinux-release file version info"
    [ -n "$release_string" ] && OS_TYPE="bclinux4anolis"
    [ -n "$release_string" ] && OS_VERSION=$(cat /etc/bclinux-release |sed 's/.* \([0-9.]\+\).*/\1/')
  fi
  echo lylos_type=$OS_TYPE","lylos_version=$OS_VERSION
}
chk_anolisgt;unset chk_anolisgt
