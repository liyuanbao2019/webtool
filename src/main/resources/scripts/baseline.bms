if [[ "$(systemctl is-active cri-o containerd docker 2>/dev/null|sort -u|grep -w active)" == "active" ]];then
  echo "host is container host, check result=true"
elif [[ "$(systemctl is-active openstack-nova-compute openstack-nova-api openstack-glance-api openstack-glance-registry openstack-keystone openstack-cinder-api neutron-server neutron-openvswitch-agent 2>/dev/null|sort -u|grep -w active)" == "active" ]];then
  echo "host is openstack cloud node, check result=true"
else
