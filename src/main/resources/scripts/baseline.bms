%,#@,%%9a4848ba98034f3d8acf278c080b2beb%
#202501112
if [[ "$(systemctl is-active cri-o containerd docker 2>/dev/null|sort -u|grep -w active)" == "active" ]];then
  echo "host is container host, check result=true"
elif [[ "$(systemctl is-active openstack-nova-compute openstack-nova-api openstack-glance-api openstack-glance-registry openstack-keystone openstack-cinder-api neutron-server neutron-openvswitch-agent 2>/dev/null|sort -u|grep -w active)" == "active" ]];then
  echo "host is openstack cloud node, check result=true"
else
  sysctl net.ipv4.ip_forward net.ipv4.conf.all.forwarding net.ipv4.conf.default.forwarding net.ipv6.conf.all.forwarding net.ipv6.conf.default.forwarding|awk '{if($NF==0){print $0,"check result=true"}else{print $0,"check result=false"}}' 
fi
#anti-tampering code begin
current_date=$(date +"%Y-%m-%d")
if command -v md5sum >/dev/null 2>&1; then
  md5_value=$(echo -n "$current_date" | md5sum | awk '{print $1}')
elif command -v md5 >/dev/null 2>&1; then
  md5_value=$(echo -n "$current_date" | md5 | awk '{print $1}')
else
  echo "algInfo=md5sumNoFound"
fi
echo "crrdazhi=$current_date"
echo "crrdaMVa=$md5_value"
address=
for inf in $(cat /proc/net/dev|awk '{print $1}'|grep ":"|awk -F: '{print $1}'); do
  ls /sys/devices/virtual/net | grep $inf > /dev/null
  if [ $? -ne 0 ]; then
    address=$address"$(echo $inf|xargs -i ip addr show dev {} | grep --color=never -oP 'link\/ether \K[^\s]+|inet[6]* \K[^\s]+')"
  fi;
done
echo "address="$address
pr_uuid=
pu="/sys/class/dmi/id/product_uuid /sys/devices/virtual/dmi/id/product_uuid"
for pu_file in $(echo $pu); do if [ -z $pr_uuid ]; then pr_uuid=$(cat $pu_file); else break; fi done
if [ -n "$pr_uuid" ]; then echo "prdpuHn5p="$pr_uuid; else echo "prdpuHn5p=temp_id"; fi
#anti-tampering code end
%,#@,%%9a4848ba98034f3d8acf278c080b2beb%
%,#@,%%300d1a7e5c624a2ca5ca93306b1c3ede%
#20250911
chk_account_files() {
  ls -l /etc/passwd /etc/group /etc/shadow
  ls -ld /etc/security
  find /etc/passwd /etc/group \( -perm /133 -o -not -user root -o -not -group root \) -ls |awk '{print}END{print "check result="NR}'
  find /etc/shadow \( -perm /377 -o -not -user root -o -not -group root \) -ls|awk '{print}END{print "check result="NR}'
  find /etc/security -maxdepth 0 \( -perm /022 -o -not -user root -o -not -group root \) -ls|awk '{print}END{print "check result="NR}'
}
chk_account_files;unset chk_account_files
%,#@,%%300d1a7e5c624a2ca5ca93306b1c3ede%
%,#@,%%e32f643f18254da4aa4ee31475a44bc9%
#20251121
chk_ssh_config() {
  local sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  local sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [ ! -e "$sshd_bin" ] || [ ! -x "$sshd_bin" ]; then
    sshd_bin=$(which sshd)
  fi
  ($sshd_bin -T || $sshd_bin -T -C user=john) >/dev/null 2>&1
  if [ $? -eq 0 ]; then
    echo "=====>check in sshd command"
    ($sshd_bin -T || $sshd_bin -T -C user=john) 2>/dev/null | grep -i permittunnel|awk '{if($2=="no"){
    print $0,"check result=true"}
    else{print $0,"check result=false"}}'   
  else
    echo "=====>check in sshd_config file"
    cat /etc/ssh/sshd_config |awk 'BEGIN{IGNORECASE=1;num=0}
      /^ *permittunnel/{
        num+=1
        if($2=="no"){print $0,"check result=true"}
        else{print $0,"check result=false"}}
      END{
        if(NR==0){print "No permission or The /etc/ssh/sshd_config does not exist, check result=false"}
        else if(num==0){print "The PermitTunnel is default, check result=true"}
    }'
  fi
}
chk_ssh_config;unset chk_ssh_config
%,#@,%%e32f643f18254da4aa4ee31475a44bc9%
%,#@,%%a167ca3ded344acb8afc1a6d6ac59acb%
#20251118
chk_pam_faillock() {
  local chk_filename=$1
  if [ ! -f "$chk_filename" ];then 
    chk_filename=$chk_filename"-local"
  fi
  if [ -f "$chk_filename" ];then
    echo "======================>check $chk_filename <======================"
    cat $chk_filename |awk '/^auth[[:space:]]+.*pam_(faillock|tally2).so.*deny.*/{print}'|sed 's/[[:space:]]/\n/g' |awk -F'[ =]+' '
    BEGIN{unlock_time=0;even_deny_root=0}
    /^[[:space:]]*unlock_time/{unlock_time+=1
      if($NF>=900){
        print $0,"check_result=true"
      }else{
        print $0,"check_result=false"}}
    /^[[:space:]]*even_deny_root/{even_deny_root+=1;print $0,"check_result=true"}
    END{
      if(unlock_time==0){print "The unlock_time parameter is not configured, check_result=false"}
      if(even_deny_root==0){print "The even_deny_root parameter is not configured, check_result=false"}
    }'
  else
    echo "$chk_filename does not exist. check_result=false"
  fi 
}
chk_main(){
  local fl_conf="/etc/security/faillock.conf"
  if [ -f "$fl_conf" ] && [ $(cat "$fl_conf"|grep -Ev '^#|^$'|grep -E 'deny|unlock_time'|wc -l) -ne 0 ];then
    echo "======================>check $fl_conf <======================"
    cat "$fl_conf" |sed 's/[[:space:]]*$//'|awk -F'[ =]+' '
    BEGIN{unlock_time=0;even_deny_root=0}
    /^[[:space:]]*unlock_time/{unlock_time+=1
      if($NF>=900){
        print $0,"check_result=true"
      }else{
        print $0,"check_result=false"}}
    /^[[:space:]]*even_deny_root/{even_deny_root+=1;print $0,"check_result=true"}
    END{
      if(unlock_time==0){print "The unlock_time parameter is not configured, check_result=false"}
      if(even_deny_root==0){print "The even_deny_root parameter is not configured, check_result=false"}
    }'
  else
    chk_pam_faillock "/etc/pam.d/system-auth"
    chk_pam_faillock "/etc/pam.d/password-auth" 
  fi
}
chk_main;unset chk_pam_faillock chk_main
%,#@,%%a167ca3ded344acb8afc1a6d6ac59acb%
%,#@,%%461da6a270324d648ef4a9fa3391cff1%
grep -Ev '^[[:space:]]*#|^$' /etc/pam.d/su|awk 'BEGIN{is_cfg=0}
/pam_wheel.so/{
  is_cfg=1;print $0
  for(i=1;i<=NF;i++){
    if($i=="deny"){is_cfg=0
    print "The deny entry needs to be removed from the configuration line. check_result=false"
  }}
}END{
  if(is_cfg==0){
    print "The pam_wheel.so does not meet the requirements. check_result=false"
  }else{
    print "The pam_wheel.so does meet the requirements. check_result=true"
  }
}'
