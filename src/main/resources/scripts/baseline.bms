%,#@,%%9e55c0ebc3274cd0a83bbe10d1462890%
#20260826
chk_ssh_banner() {
  local sshd_pid sshd_bin ssh_banner_file
  sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2; exit}')
  sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [[ ! -e "$sshd_bin" || ! -x "$sshd_bin" ]]; then
    sshd_bin=$(command -v sshd)
  fi
  ssh_banner_file=$( ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) 2>/dev/null | awk '/^[[:space:]]*[Bb]anner/{print $2}')
  if [ -z "$ssh_banner_file" ]; then
    echo "==============>check in sshd_config file"
    ssh_banner_file=$(awk '/^[[:space:]]*[Bb]anner/{print $2}' /etc/ssh/sshd_config 2>/dev/null | tail -n 1)
  fi
  if [ -f "${ssh_banner_file:=none}" ]; then
    awk 'NF{print $0", result=" ($0~/Authorized (users|uses) only\.[[:space:]]*All (activity|activities) may be monitored and reported/ ? "true" : "false")}
    END{if(NR==0){print "The file is empty, result=false"}}' "$ssh_banner_file"
  else
    echo "$ssh_banner_file file is not exist, result=false"
  fi
}
chk_ssh_banner;unset -f chk_ssh_banner
%,#@,%%9e55c0ebc3274cd0a83bbe10d1462890%
%,#@,%%e4b6a677d971477f81fd3b5ba48fe2dd%
#20260305
vsftp_droot() {
  echo "====================>check vsftpd"
  local FTPCONF
  for FTPCONF in $(ps -ef |awk '/vsftpd \//{if($3==1)print $NF}'|awk '{print $0}
  END{if(NR==0)print "/etc/vsftpd/vsftpd.conf"}');do
    if [ ! -f "${FTPCONF:=/etc/vsftpd/vsftpd.conf}" ];then
      FTPCONF="/etc/vsftpd.conf";   
    fi
    if "$REAL_RPM" -q 'vsftpd'; then
      if [ -f "$FTPCONF" ]; then
        if [ -f "/etc/pam.d/vsftpd" ]; then
          cat /etc/pam.d/vsftpd |grep pam_listfile 
          local is_enable_pam=$(cat "$FTPCONF" |grep -Ec '^pam_service_name=\S+')
          local pam_userfile=$(cat /etc/pam.d/vsftpd |grep -E '^auth\s+required\s+pam_listfile\.so'|sed 's|.*file=||g'|awk '{print $1}')
          local pam_sense=$(cat /etc/pam.d/vsftpd |grep -E '^auth\s+required\s+pam_listfile\.so' |sed 's|.*sense=||g'|awk '{print $1}')
          if [[ $is_enable_pam -ne 0 && -n "$pam_userfile" && -n "$pam_sense" ]]; then
            if [[ "$pam_sense" = "deny" && "$(cat "$pam_userfile" |grep -c root)" -ne 0 ]]; then
              echo "result=true"
            elif [[ "$pam_sense" = "allow" && "$(cat "$pam_userfile" |grep -c root)" -eq 0 ]]; then
              echo "result=true"
            fi
          else
            local userlist_enable=$(cat "$FTPCONF" |grep -E '^userlist_enable' |awk -F= 'END{if($2==""){print "NO"}else{print $2}}')
            local userlist_deny=$(cat "$FTPCONF" |grep -E '^userlist_deny' |awk -F= 'END{if($2==""){print "YES"}else{print $2}}')
            local userlist_file=$(cat "$FTPCONF" |grep -E '^userlist_file' |awk -F= 'END{if($2==""){print "/etc/vsftpd/user_list"}else{print $2}}')
            if [ -f "$userlist_file" ]; then
              local hav_root=$(cat "$userlist_file" |grep -Ec '^root$')
              if [[ $userlist_enable = "YES" && $userlist_deny = "YES" ]]; then
                [ "$hav_root" -ne 0 ] && echo "result=true"
              elif [[ $userlist_enable = "YES" && $userlist_deny = "NO" ]]; then
                [ "$hav_root" -eq 0 ] && echo "result=true"
              fi
            fi
          fi  
        fi
      else
        echo "vsftpd server is installed, but vsftpd.conf is not exist, result=false"
      fi
    else
      echo "vsftpd server is not installed, result=true"
    fi
  done     
}
pureftp_droot() {
  echo "====================>check pure-ftpd"
  if "$REAL_RPM" -q 'pure-ftpd'; then
    if [ -f "/etc/pure-ftpd/pure-ftpd.conf" ]; then
      if [ -f "/etc/pam.d/pure-ftpd" ];then
        cat /etc/pam.d/pure-ftpd|grep pam_listfile
        local pure_pam_userfile=$(cat /etc/pam.d/pure-ftpd |grep -E '^auth\s+required\s+pam_listfile\.so' |sed 's|.*file=||g'|awk '{print $1}')
        local pure_pam_sense=$(cat /etc/pam.d/pure-ftpd |grep -E '^auth\s+required\s+pam_listfile\.so'|sed 's|.*sense=||g'|awk '{print $1}')
        if [[ -n "$pure_pam_userfile" && -n "$pure_pam_sense" ]]; then
          if [[ "$pure_pam_sense" = "deny" ]]; then
            if [ "$(cat "$pure_pam_userfile" |grep -Ec '^root$')" -ne 0 ]; then
              echo "result=true"
            else
              cat /etc/pure-ftpd/pure-ftpd.conf |grep -E '^MinUID' |awk 'END{if($2>0){print "result=true"}else{print "result=false"}}'
            fi
          elif [[ "$pure_pam_sense" = "allow" ]]; then
            if [ "$(cat "$pure_pam_userfile" |grep -Ec '^root$')" -eq 0 ]; then
              echo "result=true"
            else
              cat /etc/pure-ftpd/pure-ftpd.conf |grep -E '^MinUID' |awk 'END{if($2>0){print "result=true"}else{print "result=false"}}'
            fi
          fi
        else
          cat /etc/pure-ftpd/pure-ftpd.conf |grep -E '^MinUID' |awk 'END{if($2>0){print "result=true"}else{print "result=false"}}'
        fi
      fi
    else
      echo "pure-ftpd server is installed, but pure-ftpd.conf is not exist, result=false"
    fi
  else
    echo "pure-ftpd server is not installed, result=true"
  fi
}
proftp_droot() {
  echo "====================>check proftpd"
  local FTPCONF="/etc/proftpd/proftpd.conf"
  if [ ! -f "$FTPCONF" ];then
    FTPCONF="/etc/proftpd.conf";
  fi
  if "$REAL_RPM" -q 'proftpd'; then
    if [ -f "$FTPCONF" ]; then
      cat "$FTPCONF" |awk '/^ *UseFtpUsers *off/{print $1,"check result=false"}' 
      if [ -f /etc/pam.d/proftpd ]; then
        cat /etc/pam.d/proftpd|grep pam_listfile
        local pam_userfile=$(cat /etc/pam.d/proftpd |grep -E '^auth\s+required\s+pam_listfile\.so'|sed 's|.*file=||g'|awk '{print $1}')
        local pam_sense=$(cat /etc/pam.d/proftpd |grep -E '^auth\s+required\s+pam_listfile\.so'|sed 's|.*sense=||g'|awk '{print $1}')
        if [[ "$pam_sense" = "deny" && "$(cat "$pam_userfile" |grep -Ec ^root)" -ne 0 ]]; then
          echo "result=true"
        elif [[ "$pam_sense" = "allow" && "$(cat "$pam_userfile" |grep -Ec ^root)" -eq 0 ]]; then
          echo "result=true"
        else
          echo "result=false"
        fi
      fi
    else
      echo "proftpd server is installed, but proftpd.conf is not exist, result=false"
    fi
  else
    echo "proftpd server is not installed, result=true"
  fi
}
check_main() {
  type -a rpm 2>/dev/null
  REAL_RPM=$(type -P rpm 2>/dev/null)
  if [ -z "$REAL_RPM" ] || [ ! -x "$REAL_RPM" ]; then
    if [ -x "/usr/bin/rpm" ]; then
      REAL_RPM="/usr/bin/rpm"
    elif [ -x "/bin/rpm" ]; then
      REAL_RPM="/bin/rpm"
    fi
  fi
  if [ -n "$REAL_RPM" ] && [ -x "$REAL_RPM" ]; then
    vsftp_droot;pureftp_droot;proftp_droot
    unset vsftp_droot pureftp_droot proftp_droot
  else
    echo "rpm command not available or not executable, cannot check ftp installation status, result=false"
  fi
}
check_main;unset check_main
%,#@,%%e4b6a677d971477f81fd3b5ba48fe2dd%
%,#@,%%bf6b74e1452543108d27d7095104a49d%
#20250912
chk_sshd_protocol() {
  local sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  local sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [ ! -e "$sshd_bin" ] || [ ! -x "$sshd_bin" ]; then
    sshd_bin=$(which sshd)
  fi
  ($sshd_bin -T || $sshd_bin -T -C user=john) >/dev/null 2>&1
  if [ $? -eq 0 ]; then
  echo "=====>check in sshd command"
  ($sshd_bin -T || $sshd_bin -T -C user=john) 2>/dev/null|grep -i Protocol|awk '{if($2=="2"){print $0,"check result:true"}
      else{print $0,"check result:false"}
      }END{if(NR==0){print "The Protocol is default(The default is 2), check result:true"}
    }'
  else
    echo "=====>check in sshd_config file"
    cat /etc/ssh/sshd_config|awk 'BEGIN{IGNORECASE=1;num=0}
    /^ *Protocol/{
      num+=1
      if($2=="2"){
        print $0,"check result:true"
      }else{print $0,"check result:false"}
    }END{
      if(NR==0){print "No permission or The /etc/ssh/sshd_config does not exist, check result:false"}
      if(num==0){print "The Protocol is default(The default is 2,1), check result:false"}
    }'
  fi
}
chk_sshd_protocol; unset chk_sshd_protocol
%,#@,%%bf6b74e1452543108d27d7095104a49d%
%,#@,%%50e50acf9ff74c0c8ba1de4ef447f4fd%
#20260518
chk_snmp() {
  local check_result="true"
  
  if [ "$(ps -ef | awk '/\/usr\/sbin\/snmpd /{print}' | wc -l)" == "1" ]; then
    echo "===>SNMPD service is running"
    local snmpd_conf
    snmpd_conf=/etc/snmp/snmpd.conf
    if [ ! -f "$snmpd_conf" ]; then
      snmpd_conf="/etc/snmpd.conf"
    fi
    if [ ! -f "$snmpd_conf" ]; then
      echo "===>SNMPD configuration file not found"
    else
      echo "=====>Checking SNMPD configuration file: ${snmpd_conf}"
      local snmp_context
      snmp_context=$(cat "$snmpd_conf" | grep -E -v '^#|^$' | grep -E 'public$|public[[:space:]]|private$|private[[:space:]]|rwcommunity|rocommunity')
      if [ -z "$snmp_context" ]; then
        echo "=====>SNMPD configuration is secure."
      else
        echo "=====>SNMPD configuration contains insecure settings:"
	echo "$snmp_context"
        check_result="false"
      fi
    fi
  else
    echo "===>SNMPD service is not running"
  fi
  
  echo "===>SNMP check result:${check_result}"
}
chk_snmp;unset -f chk_snmp
%,#@,%%50e50acf9ff74c0c8ba1de4ef447f4fd%
%,#@,%%f9f0d8f1f6f649918df1ca54e5dadc6b%
#20251114
chk_umask() {
  echo "The umask in profile is :"$(grep -E -v '^#|^$' /etc/profile|grep -i "umask"|tail -1)
  echo "The umask command output : umask="$(bash --login -c 'umask' 2>/dev/null|grep --color=never -E '^[0-9]{3,4}$')
  echo "The umask in login.defs is : LOGIN_"$(cat /etc/login.defs|grep -v '^#'|grep -i umask)
}
chk_umask;unset chk_umask
%,#@,%%f9f0d8f1f6f649918df1ca54e5dadc6b%
%,#@,%%6bca3ac854624cc2934a362711f89dc3%
#20260324
chk_sshd_agent() {
  local sshd_pid sshd_bin tmp_value
  sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  sshd_bin=$(readlink -f "/proc/$sshd_pid/exe" 2>/dev/null)
  if [ ! -e "$sshd_bin" ] || [ ! -x "$sshd_bin" ]; then
    sshd_bin=$(which sshd)
  fi
  tmp_value=$( ($sshd_bin -T || $sshd_bin -T -C user=john) 2>/dev/null | grep -i AllowAgentForwarding)
  if [ -n "$tmp_value" ]; then
    echo "=====>check in sshd command"
    echo "$tmp_value"|awk '{if($2=="no"){
      print $0,"check result=true"}
    else{print $0,"check result=false"}}'   
  else
    echo "=====>check in sshd_config file"
    cat /etc/ssh/sshd_config |awk '
      BEGIN{IGNORECASE=1;num=0}
      /^ *AllowAgentForwarding/{
        num+=1
        if($2=="no"){print $0,"check result=true"}
        else{print $0,"check result=false"}}
      END{
        if(NR==0){print "No permission or The /etc/ssh/sshd_config does not exist, check result=false"}
        if(num==0){print "The AllowAgentForwarding is default, check result=false"}
    }'
  fi
}
chk_sshd_agent; unset chk_sshd_agent
%,#@,%%6bca3ac854624cc2934a362711f89dc3%
%,#@,%%2d62eff0a8424591acfd9a2c23480e26%
#20251121
chk_pam(){
  local pam_file=$1
  if [ ! -f "$pam_file" ];then 
    pam_file=$pam_file"-local"
  fi
  if [ -f "$pam_file" ];then
    echo "======================>"$pam_file"<======================"
    cat $pam_file|grep --color=never -E '^[[:space:]]*auth[[:space:]]+\S+[[:space:]]+pam_(faillock|tally2)\.so'
  else
    echo "$pam_file file is not found. check_result=false"
  fi
}
chk_deny(){
  local fl_conf="/etc/security/faillock.conf"
  if [ -f "$fl_conf" ] && [ $(cat "$fl_conf"|grep -Ev '^#|^$'|grep deny|wc -l) -ne 0 ];then
    echo "======================>check $fl_conf <======================"
    cat $fl_conf |awk '!/^[[:space:]]*#/'
  else
    chk_pam /etc/pam.d/system-auth
    chk_pam /etc/pam.d/password-auth
  fi
}
chk_deny;unset chk_pam chk_deny
%,#@,%%2d62eff0a8424591acfd9a2c23480e26%
%,#@,%%44b4a785b52f49f69d0f04811f7992ff%
#20251107
chk_chk() {
  local chk_point=$1
  local en_ctrl=0
  local lib_link=$(readlink /usr/lib/systemd/system/$chk_point.target)
  local t_status=$(systemctl is-enabled $chk_point.target 2>/dev/null)
  local etc_link=$(readlink /etc/systemd/system/$chk_point.target)
  [ "$lib_link" = "reboot.target" ] && en_ctrl=1 || en_ctrl=0
  ([ "$t_status" = "" ] || [ "$t_status" = "masked" ]) && en_ctrl=0 || en_ctrl=1
  ([ "$t_status" = "" ] || [ "$etc_link" = "/dev/null" ]) && en_ctrl=0 || en_ctrl=1
  echo $en_ctrl
}
check_ctrlaltdel() {
  local en_ctrl=0
  en_ctrl=$(chk_chk "ctrl-alt-del")
  [ ! $en_ctrl ] && en_ctrl=$(chk_chk "ctrl-alt-delete")
  if [ $en_ctrl -eq 1 ];then
    echo "ctrl-alt-del.target needs to be masked, ctrlaltdel check_result=false"
  else
    local system_configfile=$(rpm -ql systemd|grep 'system.conf$')
    [ -f ${system_configfile:="/etc/systemd/system.conf"} ] && awk -F= '
    BEGIN{num=0}
    /^ *CtrlAltDelBurstAction/{
      num+=1
      if($2=="none"){
        print FILENAME":"$0,"ctrlaltdel check_result=true"
      }else{
        print FILENAME":"$0,"ctrlaltdel check_result=false"
      }
    }END{
      if(num==0){
        print "CtrlAltDelBurstAction is the default value (reboot-force). ctrlaltdel check_result=false"
      }
    }' "$system_configfile"
  fi
  if [ -s /etc/init/control-alt-delete.conf ];then
    cat /etc/init/control-alt-delete.conf|grep -Ev '^ *#|^$'|awk '
    BEGIN{num=0}
    /exec \/sbin\/shutdown/{
      num+=1
    }END{
      if(num==0){
        print "exec /sbin/shutdown does not exist in the control-alt-delete.conf file. ctrlaltdel check_result=true"
      }else{
        print "exec /sbin/shutdown exists in the control-alt-delete.conf file. ctrlaltdel check_result=false"
      }
    }'
  else
    echo "control-alt-delete.conf does not exist, ctrlaltdel check_result=true"
  fi
  if [ -s /etc/inittab ];then
    cat /etc/inittab|grep -v "^#"|awk '
    BEGIN{num=0}
    /ctrlaltdel/ && /shutdown/{
      num+=1
    }END{
      if(num==0){
        print "ca::ctrlaltdel:/sbin/shutdown does not exist in the /etc/inittab file. ctrlaltdel check_result=true"
      }else{
        print "ca::ctrlaltdel:/sbin/shutdown exists in the /etc/inittab file. ctrlaltdel check_result=false"
      }
    }'
  fi
}
check_ctrlaltdel;unset check_ctrlaltdel
%,#@,%%44b4a785b52f49f69d0f04811f7992ff%
%,#@,%%c17781a4a3d7412a9385279175068512%
#20260305
vsftp_anonymous() {
  echo "======================> check vsftpd"
  local FTPCONF
  for FTPCONF in $(ps -ef |awk '/vsftpd \//{if($3==1)print $NF}'|awk '{print $0}END{if(NR==0)print "/etc/vsftpd/vsftpd.conf"}');do
    if [ ! -f "${FTPCONF:=/etc/vsftpd/vsftpd.conf}" ];
        then FTPCONF="/etc/vsftpd.conf";   
    fi
    if "$REAL_RPM" -q 'vsftpd'; then
      if [ -f "$FTPCONF" ]; then
        cat "$FTPCONF" |grep '^[[:space:]]*anonymous_enable' |awk -F= '{
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2);
        if(toupper($2)=="NO"){print $0" ,result=true"}else{print $0" ,result=false"}}'
      else
        echo "vsftpd server is installed, but vsftpd.conf is not exist, result=false"
      fi
    else
      echo "vsftpd server is not installed, result=true"
    fi
  done
}
pureftp_anonymous() {
  echo "======================> check pure-ftpd"
  if "$REAL_RPM" -q 'pure-ftpd'; then
    if [ -f "/etc/pure-ftpd/pure-ftpd.conf" ]; then
      cat /etc/pure-ftpd/pure-ftpd.conf |grep '^NoAnonymous' |awk '{if($2=="yes"){
        print $0" ,result=true"}else{print $0" ,result=false"}}'
    else
      echo "pure-ftpd server is installed, but pure-ftpd.conf is not exist, result=false"
    fi
  else
    echo "pure-ftpd server is not installed, result=true"
  fi
}
proftp_anonymous() {
  echo "======================> check proftpd"
  local FTPCONF="/etc/proftpd/proftpd.conf"
  if [ ! -f "$FTPCONF" ];
      then FTPCONF="/etc/proftpd.conf";
  fi
  if "$REAL_RPM" -q 'proftpd'; then
    if [ -f "$FTPCONF" ]; then
      local include_files
      include_files=$(cat "$FTPCONF" |awk '/^ *Include/{print $2}')
      cat "$FTPCONF" $include_files 2>/dev/null|awk '/^ *UserAlias/{print}'
      local user_aliases
      user_aliases=$(cat "$FTPCONF" $include_files 2>/dev/null|awk '/^ *UserAlias/{print $NF}')
      if [ -n "$user_aliases" ]; then
        echo "$user_aliases"|xargs getent passwd|awk -F: '{if($NF=="/sbin/nologin" || $NF=="/usr/sbin/nologin" || $NF=="/bin/false"){print "check result=true"}else{print "check result=false"}}'
      fi
    else
      echo "proftpd server is installed, but proftpd.conf is not exist, result=false"
    fi
  else
    echo "proftpd server is not installed, result=true"
  fi
}
check_main() {
  type -a rpm 2>/dev/null
  REAL_RPM=$(type -P rpm 2>/dev/null)
  if [ -z "$REAL_RPM" ] || [ ! -x "$REAL_RPM" ]; then
    if [ -x "/usr/bin/rpm" ]; then
      REAL_RPM="/usr/bin/rpm"
    elif [ -x "/bin/rpm" ]; then
      REAL_RPM="/bin/rpm"
    fi
  fi
  if [ -n "$REAL_RPM" ] && [ -x "$REAL_RPM" ]; then
    vsftp_anonymous;pureftp_anonymous;proftp_anonymous
    unset vsftp_anonymous pureftp_anonymous proftp_anonymous
  else
    echo "rpm command not available or not executable, cannot check ftp installation status, result=false"
  fi
}
check_main;unset check_main
