#20250610
chk_ssh() {
  [ "$LC_ALL" != "en_US.UTF-8" ] && export LC_ALL="en_US.UTF-8"
  rpm -q telnet-server
  local is_installed=$(rpm -q telnet-server|grep -E -v 'is not installed|未安装'|wc -l)
  local ssh_status=$(ps -ef| grep -E 'sshd|dropbear'| grep -v grep| wc -l)
  if [ "$is_installed" -eq 0 ]; then
    echo "telnet-server is not installed, result=true"
  else
    echo "telnet-server is installed, result=false"
  fi
  if [ "$ssh_status" -ne 0 ];then
    echo "sshd is running, result=true"
  else
    echo "sshd is not running, result=false"
  fi
}
chk_ssh;unset chk_ssh
