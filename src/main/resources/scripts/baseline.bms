#20260305
vsftp_dir() {
  echo "================>check vsftpd"
  local FTPCONF=""
  for FTPCONF in $(ps -ef |awk '/vsftpd \//{if($3==1)print $NF}'|awk '{print $0}END{if(NR==0)print "/etc/vsftpd/vsftpd.conf"}');do
    if [ ! -f "${FTPCONF:="/etc/vsftpd/vsftpd.conf"}" ];then
      FTPCONF="/etc/vsftpd.conf";   
    fi
    if "$REAL_RPM" -q vsftpd >/dev/null; then
      if [ -f "$FTPCONF" ]; then
        cat "$FTPCONF"|grep -E -v "^#|^$"|grep -i chroot
        local is_enable=$(cat "$FTPCONF"|grep -v "^#" |grep -ic "chroot_local_user=YES")
        local is_disable=$(cat "$FTPCONF"|grep -v "^#" |grep -ic "chroot_list_enable=YES")
        if [ "$is_enable" -eq 1 ] && [ "$is_disable" -eq 0 ];then
          echo "vsftpd is running.$FTPCONF is recommended.FTP check result=true.";
        else  
          echo "vsftpd is running.$FTPCONF is not recommended.FTP check result=false.";
        fi
      else
        echo "vsftpd server is installed, but vsftpd.conf is not exist, result=false"
      fi
    else
      echo "vsftpd server is not installed, result=true"
    fi
  done
}
pureftp_dir() {
  echo "================>check pure-ftpd"
  if "$REAL_RPM" -q 'pure-ftpd' >/dev/null; then
    if [ -f /etc/pure-ftpd/pure-ftpd.conf ]; then
      cat /etc/pure-ftpd/pure-ftpd.conf|grep -E -v "^#|^$"
      local ChrootEveryone=$(cat /etc/pure-ftpd/pure-ftpd.conf|grep -v "^#"|grep -i "ChrootEveryone"|grep -ic "yes");
      local AllowUserFXP=$(cat /etc/pure-ftpd/pure-ftpd.conf|grep -v "^#"|grep -i "AllowUserFXP"|grep -ic "no");
      local AllowAnonymousFXP=$(cat /etc/pure-ftpd/pure-ftpd.conf|grep -v "^#"|grep -i "AllowAnonymousFXP"|grep -ic "no");
      local PUREFTPD_NO=$((ChrootEveryone + AllowUserFXP + AllowAnonymousFXP));
      if [ "$PUREFTPD_NO" -eq 3 ];then
        echo "pure-ftpd is running.pure-ftpd.conf is recommended.FTP check result=true."
      else
        echo "pure-ftpd is running.pure-ftpd.conf is not recommended.FTP check result=false."
      fi
    else
      echo "pure-ftpd server is installed, but pure-ftpd.conf is not exist, result=false"
    fi
  else
    echo "pure-ftpd server is not installed, result=true"
  fi
}
proftp_dir() {
  echo "================>check proftp"
  local FTPCONF="/etc/proftpd/proftpd.conf"
  if [ ! -f "$FTPCONF" ];
    then FTPCONF="/etc/proftpd.conf";
  fi
  if "$REAL_RPM" -q proftpd >/dev/null; then
    if [ -f "$FTPCONF" ]; then
      cat "$FTPCONF" | grep -E -v "^#|^$"
      if [ "$(cat "$FTPCONF"|grep -v "^#" |grep -ic "DefaultRoot")" -eq 1 ];
         then  echo "proftpd is running.$FTPCONF is recommended.FTP check result=true.";
         else  echo "proftpd is running.$FTPCONF is not recommended.FTP check result=false.";
      fi
    else
      echo "proftpd server is installed, but proftpd.conf is not exist, result=false"
    fi
  else
    echo "proftpd server is not installed, result=true"
  fi
}
check_main() {
  type -a rpm 2>/dev/null
  REAL_RPM=$(type -P rpm 2>/dev/null)
  if [ -z "$REAL_RPM" ] || [ ! -x "$REAL_RPM" ]; then
    if [ -x "/usr/bin/rpm" ]; then
      REAL_RPM="/usr/bin/rpm"
    elif [ -x "/bin/rpm" ]; then
      REAL_RPM="/bin/rpm"
    fi
  fi
  if [ -n "$REAL_RPM" ] && [ -x "$REAL_RPM" ]; then
    vsftp_dir;pureftp_dir;proftp_dir
    unset vsftp_dir pureftp_dir proftp_dir
  else
    echo "rpm command not available or not executable, result=false"
  fi
}
check_main;unset check_main
