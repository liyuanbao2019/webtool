%,#@,%%c902130360c1485fa35baa3530d35e4a%
#20251120
list_sys_services() {
  [ "$LC_ALL" != "en_US.UTF-8" ] && export LC_ALL="en_US.UTF-8"
  echo "==========>check chkconfig"
  command -v chkconfig && chkconfig --list |grep -E -e "\b(daytime|time|echo|discard|chargen|telnet)\b" -e "\b(sendmail|ntalk|ident|printer)\b" -e "\b(bootps|tftp|kshell|klogin)\b" -e "\b(lpd|nfs|nfs.lock|ypbind)\b"|awk '
    BEGIN{num=0}/:on/{num+=1;print $0}END{if(num>0){print "result=false"}else{print "result=true"}}'
  echo "==========>check systemctl"
  command -v systemctl && systemctl list-units --type=service --type=socket|awk '/active/{print $1}'|grep -E -e "\b(daytime|time|echo|discard|chargen|telnet)\b" -e "\b(sendmail|ntalk|ident|printer)\b" -e "\b(bootps|tftp|kshell|klogin)\b" -e "\b(lpd|nfs|nfs.lock|ypbind)\b"|awk '
    BEGIN{num=0}{num+=1;print $0}END{if(num>0){print "result=false"}else{print "result=true"}}'
  echo "==========>check port"
  if command -v netstat >/dev/null 2>&1;then
    netstat -anp|grep -E '^tcp|^udp' |awk '
    BEGIN{num=0} /:(139|445)\s+/{num+=1;print $0}
    END{if(num>0){print "result=false"}else{print "result=true"}}'
  else
    command -v ss >/dev/null 2>&1 && ss -tlnp |awk '
    BEGIN{num=0} /:(139|445)\s+/{num+=1;print $0}
    END{if(num>0){print "result=false"}else{print "result=true"}}'
  fi
}
list_sys_services;unset list_sys_services
