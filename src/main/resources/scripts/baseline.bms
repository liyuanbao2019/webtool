#20250702
check_snmpd() {
  local snmpd_status=`ps -ef|awk '/\/usr\/sbin\/snmpd /{print}'|wc -l`
  if [ "$snmpd_status" -ge 1 ];then
    local snmpd_conf=/etc/snmp/snmpd.conf
    if [ ! -f "$snmpd_conf" ];then  
      snmpd_conf=/etc/snmpd.conf
    fi
    if [ `cat "$snmpd_conf" 2>/dev/null|grep -Ev "^#"|egrep "public|private"|wc -l` -ne 0 ];then
      echo "SNMPD is running. SNMP check result:false";fi;
    cat $snmpd_conf|awk '/^group/{
      if($3=="v1"||$3=="v2c"){print $0 "SNMP check result:false"}}'
  else
    echo "SNMPD is not running.SNMP check result:true";
  fi
}
check_snmpd;unset check_snmpd
