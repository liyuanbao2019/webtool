#20260305
vsftp_banner() {
  echo "=============================check vsftpd"
  local FTPCONF
  for FTPCONF in $(ps -ef |awk '/vsftpd \//{if($3==1)print $NF}'|awk '{print $0}END{if(NR==0)print "/etc/vsftpd/vsftpd.conf"}');do
    if [ ! -f "${FTPCONF:=/etc/vsftpd/vsftpd.conf}" ];then
      FTPCONF="/etc/vsftpd.conf";   
    fi
    if "$REAL_RPM" -q vsftpd 2>/dev/null; then
      if [ -f "$FTPCONF" ]; then
        if [ "$(cat "$FTPCONF" |grep -Ec '^ftpd_banner')" -ne 0 ]; then
          cat "$FTPCONF" |grep '^ftpd_banner' |awk -F= 'END{
            if($2 ~ /Authorized users only. ?All (activity|activities) may be monitored and reported/){
              print $0" ,result=true"}else{print $0" ,result=false"}}'
        elif [ "$(cat "$FTPCONF" |grep -Ec '^banner_file')" -ne 0 ]; then
          local banner_file=$(cat "$FTPCONF" |grep '^banner_file'|awk -F= 'END{if($2!=""){print $2}}')
          if [ -f "$banner_file" ];then
            cat "$banner_file" |awk -F= 'END{
            if($0 ~ /Authorized users only. ?All (activity|activities) may be monitored and reported/){
              print $0" ,result=true"}else{print $0" ,result=false"}}'
          else
            echo "banner_file is empty, result=false"
          fi
        else
          echo "Do not config ftpd_banner or banner_file, result=false"
        fi
      else
        echo "vsftpd server is installed, but vsftpd.conf is not exist, result=false"
      fi
    else
      echo "vsftpd server is not installed, result=true"
    fi
  done
}
pureftp_banner() {
  echo "=============================check pure-ftpd"
  if "$REAL_RPM" -q 'pure-ftpd' 2>/dev/null; then
    if [ -f "/etc/pure-ftpd/pure-ftpd.conf" ]; then
      local banner_file=$(cat /etc/pure-ftpd/pure-ftpd.conf |grep '^FortunesFile' |awk '{if($2!=""){print $2}}')
      if [ -f "$banner_file" ];then
        cat "$banner_file" |awk -F= 'END{
            if($0 ~ /Authorized users only. ?All (activity|activities) may be monitored and reported/){
              print $0" ,result=true"}else{print $0" ,result=false"}}'
      else
        echo "Do not config FortunesFile, result=false"
      fi
    else
      echo "pure-ftpd server is installed, but pure-ftpd.conf is not exist, result=false"
    fi
  else
    echo "pure-ftpd server is not installed, result=true"
  fi
}
proftp_banner() {
  echo "=============================check proftpd"
  local FTPCONF="/etc/proftpd/proftpd.conf"
  if [ ! -f "$FTPCONF" ];
    then FTPCONF="/etc/proftpd.conf";
  fi
  if "$REAL_RPM" -q proftpd 2>/dev/null; then
    if [ -f "$FTPCONF" ]; then
      cat "$FTPCONF" |grep -E '^[[:space:]]*ServerIdent'|head -n 1
      local banner=$(cat "$FTPCONF" 2>/dev/null|grep -E '^[[:space:]]*ServerIdent'|head -n 1|awk '/^[[:space:]]*ServerIdent[[:space:]]+(on[[:space:]]+[^[:space:]]+|off)/'|wc -l)
      if [ "$banner" -ne 0 ];then echo "result=true"; else echo "result=false"; fi
    else
      echo "proftpd server is installed, but proftpd.conf is not exist, result=false"
    fi
  else
    echo "proftpd server is not installed, result=true"
  fi
}
check_main() {
  type -a rpm 2>/dev/null
  REAL_RPM=$(type -P rpm 2>/dev/null)
  if [ -z "$REAL_RPM" ] || [ ! -x "$REAL_RPM" ]; then
    if [ -x "/usr/bin/rpm" ]; then
      REAL_RPM="/usr/bin/rpm"
    elif [ -x "/bin/rpm" ]; then
      REAL_RPM="/bin/rpm"
    fi
  fi
  if [ -n "$REAL_RPM" ] && [ -x "$REAL_RPM" ]; then
    vsftp_banner;pureftp_banner;proftp_banner
    unset vsftp_banner pureftp_banner proftp_banner
  else
    echo "rpm command not available or not executable, result=false"
  fi
}
check_main;unset check_main
