#20260429
awk 'BEGIN {
  min_rotate["weekly"] = 26
  min_rotate["monthly"] = 6
  min_rotate["daily"] = 180
}
!/^#/ && NF {
  if ($0 ~ /\/var\/log\/wtmp \{/) {
    in_wtmp = 1
    current_rotate = 6
  }
  if ($0 ~ /}/) in_wtmp = 0
  if ($1 in min_rotate) {
    period = $1
    required = min_rotate[period]
    if (in_wtmp && period == "monthly") required = 6
    
    print FILENAME ":" $0 " ,check_result=true"
    current_rotate = required
  }
  else if ($1 == "rotate") {
    if ($2 >= current_rotate) {
      print FILENAME ":" $0 " ,check_result=true"
    } else {
      print FILENAME ":" $0 " ,check_result=false (requires at least " current_rotate " for " period ")"
    }
  }
  else if ($0 ~ /include \/etc\/logrotate\.d/) {
    print FILENAME ":" $0 " ,check_result=true"
  }
}' /etc/logrotate.conf /etc/logrotate.d/wtmp 2>/dev/null
