#20251114
chk_tmout() {
if [ -f /etc/profile ]; then
  cat /etc/profile |awk -F= 'BEGIN{num=0}
  /^export *TMOUT=|^TMOUT=/{
  if($2>0 && $2<=300){num+=1;print $0" ,result=true"}else{print "TMOUT is not available, result=false"}}
  END{if(num==0){print "The TMOUT has not been configured. result=false"}}'
fi
echo $TMOUT|awk '{if($0>0 && $0<=300)print "The TMOUT is: "$0,"result=true";else print "The TMOUT is: "$0,"result=false"}'
if [ -f /etc/csh.cshrc ]; then
  cat /etc/csh.cshrc |awk -F= '/^set *autologout=/{
  if($2>0 && $2<=300){print $0" ,result=true"}else{print "autologout is not available, result=false"}}'
fi
}
chk_tmout;unset chk_tmout
%,#@,%%f1a3a2a93c664d2cbea7115511037ee3%
%,#@,%%d5c6a44bf4cf412c97c8492efd93e046%
#20251120
list_sys_services() {
  [ "$LC_ALL" != "en_US.UTF-8" ] && export LC_ALL="en_US.UTF-8"
  if command -v chkconfig >/dev/null 2>&1;then
    chkconfig --list |grep -E -e "^\b(lp|rpc|snmpdx)\b" -e "^\b(keyserv|nscdVolmgt)\b" -e "^\b(uucp|dmi|sendmail|autoinstall)\b"|awk '
    BEGIN{num=0} /:on/{num+=1;print $0}END{if(num>0){print "result=false"}else{print "result=true"}}'
  fi
  if command -v systemctl >/dev/null 2>&1;then
    systemctl list-unit-files --type service --type socket|grep -E -e "^\b(squid|named|ncpfs|portmap)\b" -e "^\b(ypserv|yppasswdd|ypbind|smbc)\b" -e "^\b(xfsc|qpopper|cyrus|rexec|rlogin)\b" -e "^\b(rsh\b|telnet|smtp|imap)\b"|awk '
    BEGIN{num=0} /enabled/{num+=1;print $0}END{if(num>0){print "result=false"}else{print "result=true"}}'
  fi
}
list_sys_services;unset list_sys_services
%,#@,%%d5c6a44bf4cf412c97c8492efd93e046%
%,#@,%%a34e905e4464411996b61f3910be2cd2%
#20260305
chk_soft() {
  local soft_list=$("$REAL_RPM" -qa | grep -E -e "\b(tcpdump|wireshark|ethereal)\b" -e "^\b(gdb|strace|dexdump|cpp|gcc)\b")
  echo "$soft_list"
  echo "result=$(echo "$soft_list" |grep -Evc "^#|^$")"
}
check_main() {
  type -a rpm 2>/dev/null
  REAL_RPM=$(type -P rpm 2>/dev/null)
  if [ -z "$REAL_RPM" ] || [ ! -x "$REAL_RPM" ]; then
    if [ -x "/usr/bin/rpm" ]; then
      REAL_RPM="/usr/bin/rpm"
    elif [ -x "/bin/rpm" ]; then
      REAL_RPM="/bin/rpm"
    fi
  fi
  if [ -n "$REAL_RPM" ] && [ -x "$REAL_RPM" ]; then
    chk_soft
    unset chk_soft
  else
    echo "rpm command not available or not executable, result=1"
  fi
}
check_main;unset check_main
%,#@,%%a34e905e4464411996b61f3910be2cd2%
%,#@,%%06f81623a07c4cb7b007d2025f101d39%24b7bdd41dcb41c7a7ac6258e738a67b%0e8181fee47d4cdfa48ad7009e26ca9a%
#20250917
chk_syslog() {
  local SYSLOGCONF="/etc/rsyslog.conf"
  if [ ! -f  "$SYSLOGCONF" ];then
    SYSLOGCONF="/etc/syslog.conf"
  fi
  if [ -f "$SYSLOGCONF" ];then
    local include_files=$(cat $SYSLOGCONF|awk '/^\$IncludeConfig/{if($2~"/$"){print $2"*"}else{print $2}}')
    cat $SYSLOGCONF ${include_files:=$(cat $SYSLOGCONF|awk -F'"' '/^include/{print $2}')} 2>/dev/null |grep -E -v '^[[:space:]]*#|^$|@'|awk '{
     if($1 ~ "auth\\.\\*|authpriv\\.\\*|\\*\\.\\*"){print $1", result=true"}}'
  fi
}
chk_syslog_ng() {
  local FILE_NG=/etc/syslog-ng/syslog-ng.conf 
  [ -f "$FILE_NG" ] && cat $FILE_NG $(cat $FILE_NG|awk '/^@include/{if($2!~/^\"\//){print "/etc/syslog-ng/"$2}else{print $2}}' |sed 's/"//g') 2>/dev/null|grep -Ev '^[[:space:]]*#|^$'|awk '
  /^log.*filter\((f_messages|f_default)/{print $0," result=true"}'
}
is_actived=$(ps -ef |grep -E 'syslogd|syslog-ng'|grep -v grep|wc -l)
if [ ${is_actived:=0} -ne 0 ]; then
  chk_syslog;chk_syslog_ng;unset chk_syslog chk_syslog_ng
else
  echo "syslog service is not running, check result=false"
fi
%,#@,%%06f81623a07c4cb7b007d2025f101d39%24b7bdd41dcb41c7a7ac6258e738a67b%0e8181fee47d4cdfa48ad7009e26ca9a%
%,#@,%%14b8f40c1e2b49b4bf1d2e878b9b1de0%
#20260724
chk_ssh_root() {
  local sshd_pid sshd_bin
  sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [[ ! -e "$sshd_bin" || ! -x "$sshd_bin" ]]; then
    sshd_bin=$(which sshd)
  fi
  ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) &>/dev/null
  if [ $? -eq 0 ]; then
    echo "=====>check in sshd command"
    ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) 2>/dev/null | awk '/^[ \t]*[Pp]ermit[Rr]oot[Ll]ogin/{
        if($2=="no"){
          print $0,"check result:true"
        }else{
          print $0,"check result:false"
        }
    }'
  else
    echo "=====>check in sshd_config file"
    awk '/^[ \t]*[Pp]ermit[Rr]oot[Ll]ogin/{
      if($2=="no"){print $0,"check result:true"}
      else{print $0,"check result:false"}
    }END{
      if(NR==0){print "No permission or The /etc/ssh/sshd_config does not exist, check result:false"}
    }' /etc/ssh/sshd_config
  fi
}
chk_ssh_root;unset -f chk_ssh_root
#anti-tampering code begin
addr=
for inf in $(cat /proc/net/dev|awk '{print $1}'|grep ":"|awk -F: '{print $1}'); do
  ls /sys/devices/virtual/net | grep -w "$inf" > /dev/null
  if [ $? -ne 0 ]; then
    addr=$addr"$(ip addr show dev $inf | grep --color=never -oP 'link\/ether \K[^\s]+|inet[6]* \K[^\s]+')"
  fi;
done

pr_uuid=
pu="/sys/class/dmi/id/product_uuid /sys/devices/virtual/dmi/id/product_uuid"
for pu_file in $(echo $pu); do if [ -z $pr_uuid ]; then pr_uuid=$(cat $pu_file); else break; fi done
if [ -z "$pr_uuid" ]; then pr_uuid="temp_id"; fi
s=$(dd if=/dev/urandom bs=1 count=16 | base64)
c=$s$addr$pr_uuid;h=`echo -n $c|md5sum|awk '{print $1}'`
echo "saadpr7j="$s$h
#anti-tampering code end
%,#@,%%14b8f40c1e2b49b4bf1d2e878b9b1de0%
%,#@,%%1220d768704044aab8bde10c42ccc162%
sysctl net.ipv4.conf.all.accept_source_route net.ipv4.conf.default.accept_source_route net.ipv6.conf.all.accept_source_route  net.ipv6.conf.default.accept_source_route|awk '{if($NF==0){print $0,"check result=true"}else{print $0,"check result=false"}}'
%,#@,%%1220d768704044aab8bde10c42ccc162%
