#20251121
check_vul_file() {
  [ "$LC_ALL" != "en_US.UTF-8" ] && export LC_ALL="en_US.UTF-8"
  local vul_file_numbs=0
  for home_dir in `grep -E -v 'nologin|shutdown' /etc/passwd |grep sh|cut -d":" -f6`;do
    if [ -e $home_dir/.netrc ];then
      echo "$home_dir/.netrc";vul_file_numbs=`expr $vul_file_numbs + 1` ; 
    fi
    if [ -e $home_dir/.rhosts ];then
      echo "$home_dir/.rhosts";vul_file_numbs=`expr $vul_file_numbs + 1` ; 
    fi
  done
  if [ -e /etc/hosts.equiv ];then
    echo "/etc/hosts.equiv";vul_file_numbs=`expr $vul_file_numbs + 1` ; 
  fi
  if [ $(id -u) -eq 0 ];then
    echo "The number of dangerous files, result="$vul_file_numbs
  else
    echo "Insufficient permissions, check failed, result=10"
  fi
}
check_vul_file;unset check_vul_file
