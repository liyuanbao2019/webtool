%,#@,%%eb899ed446d3498eb58c31b0b131de81%
#20251120
shared_users() {
  local is_shared=$(cat /etc/passwd|grep -Ew "^test|^admin|^ceshi"|wc -l)
  if [ $is_shared -eq 0 ]; then
    if [ -f /etc/login.defs ]; then
      local up_uidmin=$(cat /etc/login.defs |grep -Ev '^#|^$' |awk '($1=="UID_MIN"){print $2;exit}')
      local up_uidmax=$(cat /etc/login.defs |grep -Ev '^#|^$' |awk '($1=="UID_MAX"){print $2;exit}')
      local users_numbs=$(cat /etc/passwd|awk -F: '($3>='${up_uidmin:=1000}' && $3<='${up_uidmax:=60000}') {print $1":"$3":"$6}')
    else
      local users_numbs=$(cat /etc/passwd|grep -Ev "^(root|oracle|sybase|postgres|mysql|apache)"|grep -Ew 'bash|sh'|awk -F: '{print $1":"$3":"$6}')
    fi
    awk 'BEGIN{num=0}NF{num+=1;print}
      END{print "The accounts are compliance, result="num}' <<< "$users_numbs"
    for ff in $users_numbs;do
      local home_dir=$(echo $ff|awk -F: '{print $3}')
      stat -Lc %a $home_dir 2>/dev/null|awk -v homedir=$home_dir '{
        if(substr($1,2,1)>5||substr($1,3,1)>0){
          print homedir" privilege is: "$0" ,result=0"
      }}'
    done
  else
    echo "There are accounts such as test admin ceshi, result=0"
  fi
}
shared_users;unset shared_users
