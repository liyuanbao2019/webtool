#20251105
chk_remember() {
  local pam_file=$1
  if [ ! -f "$pam_file" ];then 
    pam_file=$pam_file"-local"
  fi
  if [ -f "$pam_file" ];then
    echo "===>check file: $pam_file"
    cat "$pam_file" |awk '
    /^password[[:space:]]*(required|sufficient|requisite)[[:space:]]*pam_pwhistory.*enforce_for_root/{
      for(i=1;i<=NF;i++){
        if($i~/remember/){num+=1;print "===>The remember configured by pam_pwhistory is: check_result_"$i}
      }}
    /^password[[:space:]]*(required|sufficient|requisite)[[:space:]]*pam_unix.*/{
      for(i=1;i<=NF;i++){
        if($i~/remember/){num+=1;print "===>The remember configured of pam_unix is: check_result_"$i}
      }
    }END{
      if(num==0)print "===>The remember has not been configured. check_result_remember=0"
    }'
  else
    echo "$pam_file was not found. check_result=false"
  fi
}
chk_main() {
  local rmber=$(cat /etc/security/pwhistory.conf 2>/dev/null|grep -E '^[[:space:]]*remember')
  if [ -n "$rmber" ];then
    echo "===>check file: /etc/security/pwhistory.conf"
    echo "$rmber"|awk -F'[= ]+' '/remember/{print "remember="$NF}'
  else
    chk_remember /etc/pam.d/system-auth
    chk_remember /etc/pam.d/password-auth
  fi
}
chk_main;unset chk_remember chk_main
