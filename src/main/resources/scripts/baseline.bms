%,#@,%%8ebe7f9e0d2a490aa9b20b3e00c9b2e0%
#20260724
chk_files_motd() {
  if [ -f "$1" ]; then
    echo "============>$1"
    awk 'NF{
      if ($0~/Authorized (users|uses) only\.[ \t]*All (activity|activities) may be monitored and reported/){
        print $0", result=true"
      } else {
        print $0", result=false"
      }}
      END{if(NR==0){print "The file is empty, result=false"}}' "$1"
  else
    echo "$1 is not exist, result=true"
  fi
}
chk_banner() {
  chk_files_motd /etc/issue
  chk_files_motd /etc/motd
  chk_files_motd /etc/issue.net
  local sshd_pid sshd_bin
  sshd_pid=$(ps -ef | awk '/bin\/sshd / && $3 == 1 {print $2}')
  sshd_bin=$(ls -l /proc/"$sshd_pid"/exe 2>/dev/null | awk '{print $NF}')
  if [[ ! -e "$sshd_bin" || ! -x "$sshd_bin" ]]; then
    sshd_bin=$(which sshd)
  fi
  local ssh_banner_file
  ssh_banner_file=""
  ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) &>/dev/null
  if [ $? -eq 0 ]; then
    echo "=====>check in sshd command"
    ssh_banner_file=$( ("$sshd_bin" -T || "$sshd_bin" -T -C user=john) 2>/dev/null | awk '/^[ \t]*[Bb]anner/{print $2}')
  else
    echo "=====>check in sshd_config file"
    ssh_banner_file=$(awk '/^[ \t]*[Bb]anner/{print $2}' /etc/ssh/sshd_config 2>/dev/null)
  fi
  if [ -f "${ssh_banner_file:=none}" ]; then
    chk_files_motd "$ssh_banner_file"
  else
    echo "banner is $ssh_banner_file or not exist, result=false"
  fi
}
chk_banner;unset -f chk_files_motd chk_banner
