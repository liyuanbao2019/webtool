%,#@,%%9ee85aa994d4488b8e3119dec8c51ed7%
#20260827
chk_syslog() {
  local syslog_conf=/etc/rsyslog.conf
  if [ ! -f "$syslog_conf" ]; then
    syslog_conf=/etc/syslog.conf
  fi
  if [ -f "$syslog_conf" ]; then
    echo "==============>check $syslog_conf"
    local include_cfg syslog_content
    include_cfg=$(awk '
      match($0, /include\(file="([^"]+)"/, a) {
      path = a[1]
      if (substr(path, length(path)) == "/") path = path "*"
      print path
      next
     }
     /^\$IncludeConfig/ {
      path = $2
      if (substr(path, length(path)) == "/") path = path "*"
      print path
     }' "$syslog_conf")
    syslog_content=$(cat "$syslog_conf" ${include_cfg:=$(awk -F'"' '/^include/{print $2}' "$syslog_conf")} 2>/dev/null | grep -Ev '^[[:space:]]*#|^$')
    echo "$syslog_content" | awk -F@ '/^.*\..*[[:space:]]*@/{print "check_result=true remote_log result=" $NF}'
    echo "$syslog_content" | awk '/:omrelp:/{if(match($0,/:omrelp:(.+)/,m)){host=m[1]; sub(/:[0-9]+$/,"",host); print "check_result=true remote_log result=" host}}'
    echo "$syslog_content" | tr '\n' ' ' | awk '{
      s=$0
      while ((idx = index(s, "action(")) > 0) {
        s = substr(s, idx)
        depth = 0
        endp = 0
        for (i = 1; i <= length(s); i++) {
          ch = substr(s, i, 1)
          if (ch == "(") depth++
          if (ch == ")") { depth--; if (depth == 0) { endp = i; break } }
        }
        if (endp > 0) {
          block = substr(s, 1, endp)
          if (block ~ /"omfwd"/ && match(block, /[Tt]arget="([^"]+)"/, a))
            {print "check_result=true remote_log result=" a[1]}
          s = substr(s, endp + 1)
        } else break
      }
    }'
    echo "$syslog_content" | tr '\n' ' ' | awk '{
      while (match($0, /if[[:space:]]+[^{]*then[[:space:]]*\{[^}]*\}/)) {
        block = substr($0, RSTART, RLENGTH)
        if (block ~ /"omfwd"/ && match(block, /[Tt]arget="([^"]+)"/, a))
          {print "check_result=true remote_log result=" a[1] " (conditional)"}
        $0 = substr($0, RSTART + RLENGTH)
      }
    }' | sort -u
  fi
}
chk_syslog_ng() {
  local ng_cfg=/etc/syslog-ng/syslog-ng.conf
  if [ -f "$ng_cfg" ]; then
    echo "==============>check $ng_cfg"
    local include_cfg ng_content
    include_cfg=$(awk '/^@include/{print ($2!~/^"\// ? "/etc/syslog-ng/"$2 : $2)}' "$ng_cfg" | sed 's/"//g')
    ng_content=$(cat "$ng_cfg" $include_cfg 2>/dev/null | sed 's/^[[:space:]]*//g' | grep -Ev '^[[:space:]]*#|^$' | awk -F'[( ]+' '
      /^destination.*(tcp|udp)/{
        gsub(/"/, "", $5)
        print $2":"$5
      }')
    for data in $ng_content; do
      local d_loghost ip_addr=""
      d_loghost=$(awk -F: '{print $1}' <<< "$data")
      if grep -q ':' <<< "$data"; then
        ip_addr=$(sed 's/^[^:]*://' <<< "$data")
      fi
      cat "$ng_cfg" $include_cfg 2>/dev/null | awk -v ipadd="$ip_addr" -v host="$d_loghost" '
        /log.*destination\(/{if($0 ~ host && (ipadd ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || ipadd ~ /^[0-9a-fA-F:]+$/)){print "check_result=true remote_log result=" ipadd}}'
    done
  fi
}
chk_main() {
  if [ "$(ps -ef | grep -cE '[s]yslogd|[s]yslog-ng')" -gt 0 ]; then
    chk_syslog
    chk_syslog_ng
    unset -f chk_syslog chk_syslog_ng
  else
    echo "syslog service is not running, check_result=false"
  fi
}
chk_main;unset -f chk_main
