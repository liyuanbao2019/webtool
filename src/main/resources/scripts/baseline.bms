%,#@,%%b3a304fc411c4a2f9ecb2b6b6c3e25f4%
#20250911
chk_minclass() {
  local pam_file=$1
  if [ ! -f "$pam_file" ];then 
    pam_file=$pam_file"-local"
  fi
  if [ -f "$pam_file" ];then
    local _tmp=$(cat $pam_file|grep -v "#")
    local DCREDIT=`echo "$_tmp"|grep -m 1 -w "dcredit"|sed 's/^.*dcredit[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local LCREDIT=`echo "$_tmp"|grep -m 1 -w "lcredit"|sed 's/^.*lcredit[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local UCREDIT=`echo "$_tmp"|grep -m 1 -w "ucredit"|sed 's/^.*ucredit[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local OCREDIT=`echo "$_tmp"|grep -m 1 -w "ocredit"|sed 's/^.*ocredit[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local MINCLASS=`echo "$_tmp"|grep -m 1 -w "minclass"|sed 's/^.*minclass[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local MINLEN=`echo "$_tmp"|grep -m 1 "minlen"|sed 's/^.*minlen[[:space:]]*=[[:space:]]*//g'|sed 's/[[:space:]].*$//g'`
    local ENFORCE=`echo "$_tmp"|grep enforce_for_root|wc -l`
    local COUNT2=0
    for NO in $DCREDIT $LCREDIT $UCREDIT $OCREDIT;do
      if [ "${NO:-0}" -lt 0 ];then
        COUNT2=`expr $COUNT2 + 1`
      fi
    done
    [ ${MINCLASS:=0} -ge 3 -o "$COUNT2" -ge 3 ] && is_minclass=4
    [ ${MINLEN:=0} -ge 8 ] && is_length=8
    [ ${ENFORCE:=0} -ge 1 ] && is_enforce=1
  else
    echo "$1 file is not found."
  fi
}
chk_main() {
  is_minclass=0
  is_length=0
  is_enforce=0
  [ -f /lib64/security/pam_pwquality.so ] && chk_minclass "/etc/security/pwquality.conf"
  [ -f /lib64/security/pam_cracklib.so -o -f /lib64/security/pam_pwquality.so ] && chk_minclass "/etc/pam.d/password-auth"
  [ -f /lib64/security/pam_cracklib.so -o -f /lib64/security/pam_pwquality.so ] && chk_minclass "/etc/pam.d/system-auth"
  if [ $is_minclass -eq 4 ] && [ $is_length -eq 8 ] && [ $is_enforce -eq 1 ];then
    echo "The complexity of the password meets the requirements. check_result=true"
  else
    echo "Minimum character types: $is_minclass"
    echo "Minimum password length: $is_length"
    echo "Whether to force root: $is_enforce"
    echo "The complexity of the password does not meet the requirements. check_result=false"
  fi
}
chk_main;unset is_minclass is_length is_enforce chk_minclass chk_main
