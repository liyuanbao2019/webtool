#20260512
echo "------Begin Read Linux /etc/shadow"
cat /etc/shadow
echo "------End Read Linux /etc/shadow"
echo "------Begin Read Linux /etc/passwd"
cat /etc/passwd
echo "------End Read Linux /etc/passwd"
#anti-tampering code begin
current_date=$(date +"%Y-%m-%d")
if command -v md5sum >/dev/null 2>&1; then
  md5_value=$(echo -n "$current_date" | md5sum | awk '{print $1}')
elif command -v md5 >/dev/null 2>&1; then
  md5_value=$(echo -n "$current_date" | md5 | awk '{print $1}')
else
  echo "algInfo=md5sumNoFound"
fi
echo "crrdazhi=$current_date"
echo "crrdaMVa=$md5_value"
address=
for inf in $(cat /proc/net/dev|awk '{print $1}'|grep ":"|awk -F: '{print $1}'); do
  ls /sys/devices/virtual/net | grep $inf > /dev/null
  if [ $? -ne 0 ]; then
    address=$address"$(echo $inf|xargs -i ip addr show dev {} | grep --color=never -oP 'link\/ether \K[^\s]+|inet[6]* \K[^\s]+')"
  fi;
done
echo "address="$address
pr_uuid=
pu="/sys/class/dmi/id/product_uuid /sys/devices/virtual/dmi/id/product_uuid"
for pu_file in $(echo $pu); do if [ -z $pr_uuid ]; then pr_uuid=$(cat $pu_file); else break; fi done
if [ -n "$pr_uuid" ]; then echo "prdpuHn5p="$pr_uuid; else echo "prdpuHn5p=temp_id"; fi
addr=
for inf in $(cat /proc/net/dev|awk '{print $1}'|grep ":"|awk -F: '{print $1}'); do
  ls /sys/devices/virtual/net | grep -w "$inf" > /dev/null
  if [ $? -ne 0 ]; then
    addr=$addr"$(ip addr show dev $inf | grep --color=never -oP 'link\/ether \K[^\s]+|inet[6]* \K[^\s]+')"
  fi;
done

pr_uuid=
pu="/sys/class/dmi/id/product_uuid /sys/devices/virtual/dmi/id/product_uuid"
for pu_file in $(echo $pu); do if [ -z $pr_uuid ]; then pr_uuid=$(cat $pu_file); else break; fi done
if [ -z "$pr_uuid" ]; then pr_uuid="temp_id"; fi
s=$(dd if=/dev/urandom bs=1 count=16 | base64)
c=$s$addr$pr_uuid;h=`echo -n $c|md5sum|awk '{print $1}'`
echo "saadpr7j="$s$h
#anti-tampering code end
%,#@,%%b3034e668a0746fdaeb4add30e001ca6%
